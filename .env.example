# Copy to .env (gitignored). All large model/data caches live on D: — C: has very little slack.
HF_HOME=D:/ml-cache/voice-agent/hf_cache
OLLAMA_MODELS=D:/ml-cache/voice-agent/ollama_models
PIPER_BIN=D:/ml-cache/voice-agent/piper_bin/piper/piper.exe
PIPER_VOICE=D:/ml-cache/voice-agent/piper_voices/en_US-lessac-medium.onnx
MODEL_WEIGHTS_DIR=D:/ml-cache/voice-agent/model_weights
DATA_DIR=./data

# Local LLM served via Ollama (server must be started with OLLAMA_MODELS set — see README)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b-instruct-q4_K_M
